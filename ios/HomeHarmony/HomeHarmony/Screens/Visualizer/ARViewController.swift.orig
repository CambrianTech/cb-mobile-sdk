    func searchPressed(_ sender: Any) {
        self.searchBottomSheet.show(true)
    }
    
    func showCloseProducts(_ show: Bool) {
        self.view.isHidden = false
        var finalPos:CGFloat = 0
        
        if(show) {
            finalPos = self.bottomSelectorSheet.view.frame.minY - self.closeProductsButton.frame.height
        } else {
            finalPos = self.view.frame.height
        }
        
        UIView.animate(withDuration: 0.3, delay: 0.0, options: UIViewAnimationOptions(), animations: {
            if show {
                self.closeProductsButton.isHidden = false
            }
            self.closeProductsButton.frame.origin.y = finalPos
            self.closeProductsButton.layoutSubviews()
        }, completion: { finished in
            if !show {
                self.closeProductsButton.isHidden = true
            }
        })
    }
    
    /************************
     *
     *     ITEM HANDLING
     *
     *///////////////////////
    
    // delegate method
    func itemSelected(_ sender: AnyObject, item: BrandItem) {
        if model!.isFirstItem() {   // check if this is the very first selected item
            self.moreButton.isHidden = false
            self.showMoreMenu(true, delay: 0.5)
        }
        self.model!.itemSelected(item: item)
        
    }
    
    func setSelectedItem(item: BrandItem) {
        self.assetsVC?.selectedItem(item)
    }
    
    /************************
     *
     *      TOOL HANDLING
     *
     *///////////////////////
    
    func lightingStart() -> CBLightingType {
        showMoreMenu(false)
        self.captureButton.isHidden = true

        self.openProductsButton.isHidden = true
        self.openProductsLabel.isHidden = true
        self.assetsVC!.view.isHidden = true
        self.moreButton.isHidden = true
        navigationItem.setLeftBarButtonItems(self.cancelButton, animated: true)
        
        self.rightButton.title = "Apply"
        self.rightButton.action = #selector(self.applyPressed)
        self.rightButton.customView?.isHidden = false
        
        return self.augmentedView.scene.lightingAdjustment
    }
    
    func toolsFinish() {
        if(isLiveView) {
            self.captureButton.isHidden = false
        }
        self.showMoreMenu(false)
        self.openProductsButton.isHidden = false
        self.openProductsLabel.isHidden = false
        self.moreButton.isHidden = false
        
        navigationItem.setLeftBarButtonItems(self.cancelButton, animated: true)
        self.toggleRightButton()
        self.rightButton.action = #selector(self.rightButtonPressed)
    }
    
    func setToolMode(_ mode: CBToolMode) {
        print("setting tool mode")
        self.augmentedView.toolMode = mode
        
        var image: UIImage?
        switch mode {
        case .paintbrush:
            image = UIImage(named: "ic_paintbrush")
        case .eraser:
            image = UIImage(named: "ic_eraser")
        default:
            image = UIImage(named: "ic_paintbrush")
        }
        self.toolsButton.setImage(image, for: .normal)
        self.toolsButton.imageView?.tintColor = UIColor.white
        
        self.showMoreMenu(false)
    }
    
    func setLightingMode(_ light: CBLightingType) {
        self.augmentedView.scene.lightingAdjustment = light
    }
    
    
    /************************
     *
     * VIEW STATE & ANIMATION
     *
     *///////////////////////
    
    func showMoreMenu(_ show: Bool, delay: Double = 0.0) {
        UIView.animate(withDuration: 0.15, delay: delay, options: .curveEaseInOut, animations: {
            if show {
                self.moreButtonContainer.transform = CGAffineTransform(rotationAngle: CGFloat.pi / 4)
            } else {
                self.moreButtonContainer.transform = .identity
            }
            
            self.assetsVC?.view.isHidden = true
            self.tools?.showTools(false)
            
            if (getTargetName() == "Builder") {
                self.assetsButton.isHidden = true
            }
            
            if(!(getTargetName() == "ShawDemo")) {
                self.favoritesButton.isHidden = !show
            }
            
            
        }) {(true) in
            self.assetsButton.isHidden = !show
            self.toolsButton.isHidden = !show
        }
        self.view.layoutIfNeeded()
    }
}
