<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/bottom_sheet"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#0000"
    android:clickable="true"
    android:elevation="5dp"
    app:behavior_hideable="true">

    <View
        android:id="@+id/sheet_shadow"
        android:layout_width="0dp"
        android:layout_height="7dp"
        android:background="@drawable/shadow_top"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <TextView
        android:id="@+id/item_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#fff"
        android:clickable="false"
        android:paddingBottom="12dp"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:text="Color Name"
        android:textColor="#555"
        android:textSize="20sp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sheet_shadow" />

    <Button
        android:id="@+id/hide_sheet_button"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginEnd="12dp"
        android:background="#0000"
        android:drawablePadding="-22dp"
        android:drawableRight="@drawable/ic_chevron_down"
        android:drawableTint="#777"
        android:text="Hide"
        android:textAllCaps="false"
        android:textColor="#777"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="@+id/item_name"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/item_name" />


    <ImageView
        android:id="@+id/item_preview"
        android:layout_width="0dp"
        android:layout_height="150dp"
        android:background="#ce2532"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/item_name" />


    <View
        android:id="@+id/bottom_sheet_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#fff"
        app:layout_constraintBottom_toBottomOf="@+id/padding"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/item_preview"/>


    <TextView
        android:id="@+id/color_sheet_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:text="@string/product_details"
        android:textColor="#000"
        android:textSize="22sp"
        app:layout_constraintLeft_toLeftOf="@+id/bottom_sheet_container"
        app:layout_constraintTop_toTopOf="@+id/bottom_sheet_container" />


    <View
        android:layout_width="120dp"
        android:layout_height="1dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="8dp"
        android:background="#000"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/color_sheet_title" />


    <TextView
        android:id="@+id/paint_details"
        android:layout_width="wrap_content"
        android:layout_height="60dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:lineSpacingMultiplier="1.3"
        android:text="@string/product_detail"
        android:textColor="#000"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/color_sheet_title" />

    <ImageView
        android:id="@+id/prestige_info_icon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp"
        android:tint="#aaa"
        android:visibility="gone"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/paint_details"
        app:srcCompat="@drawable/ic_info" />

    <TextView
        android:id="@+id/prestige_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginStart="4dp"
        android:textColor="#aaa"
        app:layout_constraintLeft_toRightOf="@+id/prestige_info_icon"
        app:layout_constraintRight_toRightOf="@+id/item_preview"

        app:layout_constraintTop_toTopOf="@+id/prestige_info_icon"/>


    <ImageView
        android:id="@+id/brand_logo"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/paint_details"
        app:layout_constraintLeft_toRightOf="@+id/color_sheet_title"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/color_sheet_title"/>


    <Button
        android:id="@+id/buy_now_button"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginEnd="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        android:drawableLeft="@drawable/ic_amazon"
        android:drawablePadding="16dp"
        android:gravity="center_vertical"
        android:paddingStart="32dp"
        android:text="@string/buy_now"
        android:textAllCaps="false"
        android:textColor="#fff"
        android:textSize="16sp"
        android:theme="@style/ButtonTheme"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/prestige_info" />


    <Button
        android:id="@+id/button_add_favorite"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginEnd="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:drawableLeft="@drawable/ic_add"
        android:drawablePadding="16dp"
        android:gravity="center_vertical"
        android:paddingBottom="12dp"
        android:paddingStart="32dp"
        android:text="Add To Favorites"
        android:textAllCaps="false"
        android:textColor="#fff"
        android:textSize="16sp"
        android:theme="@style/ButtonTheme"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/buy_now_button"/>

    <View
        android:id="@+id/padding"
        android:layout_width="0dp"
        android:layout_height="12dp"
        app:layout_constraintTop_toBottomOf="@+id/button_add_favorite"
        tools:layout_editor_absoluteX="0dp" />


</android.support.constraint.ConstraintLayout>