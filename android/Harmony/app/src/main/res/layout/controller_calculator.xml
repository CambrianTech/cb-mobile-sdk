<?xml version="1.0" encoding="utf-8"?>
<android.support.design.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimary">


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">


        <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:orientation="vertical"
            android:id="@+id/calculator_parent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            >


            <TextView
                android:id="@+id/calculator_instructions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Measure and enter room dimensions: "
                android:textColor="#fff"
                android:textSize="18sp"
                app:layout_constraintLeft_toLeftOf="@id/calculator_parent"
                android:layout_marginLeft="16dp"
                app:layout_constraintTop_toTopOf="@id/calculator_parent"
                android:layout_marginTop="72dp"
                android:layout_marginBottom="16dp"/>

            <android.support.v7.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="8dp"
                android:layout_marginBottom="8dp">

                <android.support.constraint.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/dims_parent">

                    <TextView
                        android:id="@+id/wall_width_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Wall Width:"
                        app:layout_constraintTop_toTopOf="@+id/dims_parent"
                        android:layout_marginTop="24dp"
                        app:layout_constraintLeft_toLeftOf="@id/dims_parent"
                        android:layout_marginLeft="24dp"/>

                    <android.support.constraint.Guideline
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:id="@+id/guideline_center"
                        app:layout_constraintGuide_percent="0.49" />

                    <TextView
                        android:id="@+id/wall_height_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Wall Height:"
                        app:layout_constraintTop_toTopOf="@id/dims_parent"
                        android:layout_marginTop="24dp"
                        app:layout_constraintLeft_toRightOf="@id/guideline_center"
                        android:layout_marginLeft="16dp"/>


                    <EditText
                        android:id="@+id/width_input"
                        android:layout_width="70dp"
                        android:layout_height="60dp"
                        android:inputType="number"
                        android:maxLength="4"
                        android:hint="feet"
                        app:layout_constraintTop_toBottomOf="@id/wall_width_title"
                        android:layout_marginTop="16dp"
                        app:layout_constraintLeft_toLeftOf="@id/dims_parent"
                        android:layout_marginLeft="24dp"/>


                    <EditText
                        android:id="@+id/height_input"
                        android:layout_width="70dp"
                        android:layout_height="60dp"
                        android:inputType="number"
                        android:maxLength="4"
                        android:hint="feet"
                        app:layout_constraintTop_toBottomOf="@id/wall_height_title"
                        android:layout_marginTop="16dp"
                        app:layout_constraintLeft_toLeftOf="@id/guideline_center"
                        android:layout_marginLeft="16dp"/>

                    <View
                        android:layout_width="wrap_content"
                        android:layout_height="16dp"
                        app:layout_constraintTop_toBottomOf="@id/height_input"
                        />

                </android.support.constraint.ConstraintLayout>

            </android.support.v7.widget.CardView>


            <android.support.v7.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="8dp"
                android:layout_marginBottom="8dp">

                <android.support.constraint.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/doors_parent">

                    <TextView
                        android:id="@+id/windows_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Windows:"
                        app:layout_constraintTop_toTopOf="@+id/doors_parent"
                        android:layout_marginTop="24dp"
                        app:layout_constraintLeft_toLeftOf="@id/doors_parent"
                        android:layout_marginLeft="24dp"/>


                    <ImageButton
                        android:id="@+id/window_remove"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:theme="@style/ButtonTheme"
                        app:srcCompat="@drawable/ic_minus"
                        android:scaleType="centerCrop"
                        android:tint="#fff"
                        app:layout_constraintTop_toBottomOf="@id/windows_title"
                        android:layout_marginTop="8dp"
                        app:layout_constraintLeft_toLeftOf="@id/doors_parent"
                        android:layout_marginLeft="16dp"/>

                    <TextView
                        android:id="@+id/window_num"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6dp"
                        android:paddingBottom="16dp"
                        android:text="0"
                        android:textColor="#000"
                        android:textSize="18sp"
                        app:layout_constraintTop_toTopOf="@+id/window_add"
                        android:layout_marginTop="8dp"
                        app:layout_constraintLeft_toRightOf="@id/window_remove"/>

                    <ImageButton
                        android:id="@+id/window_add"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:theme="@style/ButtonTheme"
                        app:srcCompat="@drawable/ic_add"
                        android:scaleType="centerCrop"
                        android:tint="#fff"
                        app:layout_constraintTop_toBottomOf="@id/windows_title"
                        android:layout_marginTop="8dp"
                        app:layout_constraintLeft_toRightOf="@id/window_num"
                        android:layout_marginLeft="6dp"/>

                    <android.support.constraint.Guideline
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:id="@+id/guideline_center_door"
                        app:layout_constraintGuide_percent="0.49" />

                    <TextView
                        android:id="@+id/doors_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Doors:"
                        app:layout_constraintTop_toTopOf="@id/doors_parent"
                        android:layout_marginTop="24dp"
                        app:layout_constraintLeft_toRightOf="@id/guideline_center_door"
                        android:layout_marginLeft="16dp"/>

                    <ImageButton
                        android:id="@+id/door_remove"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:theme="@style/ButtonTheme"
                        app:srcCompat="@drawable/ic_minus"
                        android:scaleType="centerCrop"
                        android:tint="#fff"
                        app:layout_constraintTop_toBottomOf="@id/windows_title"
                        android:layout_marginTop="8dp"
                        app:layout_constraintLeft_toLeftOf="@id/guideline_center_door"
                        android:layout_marginLeft="16dp"/>

                    <TextView
                        android:id="@+id/door_num"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6dp"
                        android:paddingBottom="16dp"
                        android:text="0"
                        android:textColor="#000"
                        android:textSize="18sp"
                        app:layout_constraintTop_toTopOf="@+id/door_add"
                        android:layout_marginTop="8dp"
                        app:layout_constraintLeft_toRightOf="@+id/door_remove"/>

                    <ImageButton
                        android:id="@+id/door_add"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:theme="@style/ButtonTheme"
                        app:srcCompat="@drawable/ic_add"
                        android:scaleType="centerCrop"
                        android:tint="#fff"
                        app:layout_constraintTop_toBottomOf="@+id/doors_title"
                        android:layout_marginTop="8dp"
                        app:layout_constraintLeft_toRightOf="@id/door_num"
                        android:layout_marginLeft="6dp"/>


                </android.support.constraint.ConstraintLayout>

            </android.support.v7.widget.CardView>

            <android.support.v7.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="8dp"
                android:layout_marginBottom="8dp">

                <android.support.constraint.ConstraintLayout
                    android:id="@+id/coats_parent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/coats_radio_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Number of Coats: "
                        android:textSize="17sp"
                        app:layout_constraintLeft_toLeftOf="@id/coats_parent"
                        android:layout_marginLeft="16dp"
                        android:layout_marginRight="16dp"
                        app:layout_constraintTop_toTopOf="@id/coats_parent"
                        android:layout_marginTop="24dp"/>

                    <RadioGroup
                        android:id="@+id/coats_radio_group"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingBottom="16dp"
                        android:paddingLeft="12dp"
                        android:checkedButton="@+id/radio_coat_one"
                        app:layout_constraintTop_toBottomOf="@id/coats_radio_title"
                        android:layout_marginTop="16dp"
                        app:layout_constraintLeft_toLeftOf="@id/coats_parent"
                        app:layout_constraintRight_toRightOf="@id/coats_parent">
                        <RadioButton
                            android:id="@+id/radio_coat_one"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="One Coat"
                            android:theme="@style/Prestige.Radio"
                            android:padding="4dp"/>
                        <RadioButton
                            android:id="@+id/radio_coat_two"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Two Coats"
                            android:theme="@style/Prestige.Radio"
                            android:padding="4dp"/>
                        <RadioButton
                            android:id="@+id/radio_coat_three"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Three Coats"
                            android:theme="@style/Prestige.Radio"
                            android:padding="4dp"/>
                    </RadioGroup>

                </android.support.constraint.ConstraintLayout>

            </android.support.v7.widget.CardView>

            <android.support.v7.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="8dp"
                android:layout_marginBottom="8dp">

                <android.support.constraint.ConstraintLayout
                    android:id="@+id/type_parent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/type_radio_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Interior or Exterior"
                        android:textSize="17sp"
                        app:layout_constraintLeft_toLeftOf="@id/type_parent"
                        android:layout_marginLeft="16dp"
                        android:layout_marginRight="16dp"
                        app:layout_constraintTop_toTopOf="@id/type_parent"
                        android:layout_marginTop="24dp"/>

                    <RadioGroup
                        android:id="@+id/type_radio_group"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingBottom="16dp"
                        android:paddingLeft="12dp"
                        android:checkedButton="@+id/radio_type_interior"
                        app:layout_constraintTop_toBottomOf="@id/type_radio_title"
                        android:layout_marginTop="16dp"
                        app:layout_constraintLeft_toLeftOf="@id/type_parent"
                        app:layout_constraintRight_toRightOf="@id/type_parent">
                        <RadioButton
                            android:id="@+id/radio_type_interior"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Interior"
                            android:theme="@style/Prestige.Radio"
                            android:padding="4dp"
                            android:layout_marginRight="16dp"/>
                        <RadioButton
                            android:id="@+id/radio_type_exterior"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Exterior"
                            android:theme="@style/Prestige.Radio"
                            android:padding="4dp"/>
                    </RadioGroup>

                </android.support.constraint.ConstraintLayout>

            </android.support.v7.widget.CardView>

            <android.support.v7.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="8dp"
                android:layout_marginBottom="8dp">

                <android.support.constraint.ConstraintLayout
                    android:id="@+id/result_parent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/result_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Result: "
                        android:textSize="17sp"
                        app:layout_constraintLeft_toLeftOf="@+id/result_parent"
                        android:layout_marginLeft="16dp"
                        android:layout_marginRight="16dp"
                        app:layout_constraintTop_toTopOf="@+id/result_parent"
                        android:layout_marginTop="24dp"/>

                    <TextView
                        android:id="@+id/paint_can_total"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Paint Cans Required: "
                        app:layout_constraintTop_toBottomOf="@+id/result_title"
                        app:layout_constraintLeft_toLeftOf="@+id/result_parent"
                        android:layout_marginTop="16dp"
                        android:layout_marginLeft="24dp"/>

                    <TextView
                        android:id="@+id/paint_can_total_num"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="18sp"
                        android:textColor="#000"
                        app:layout_constraintBaseline_toBaselineOf="@id/paint_can_total"
                        app:layout_constraintLeft_toRightOf="@+id/paint_can_total"
                        android:layout_marginTop="16dp"
                        android:layout_marginLeft="12dp"/>


                    <TextView
                        android:id="@+id/sqr_feet_total"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total square feet: "
                        app:layout_constraintTop_toBottomOf="@+id/paint_can_total"
                        app:layout_constraintLeft_toLeftOf="@+id/result_parent"
                        android:layout_marginTop="16dp"
                        android:layout_marginLeft="24dp"
                        android:paddingBottom="16dp"/>

                    <TextView
                        android:id="@+id/sqr_feet_total_num"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="18sp"
                        android:textColor="#000"
                        app:layout_constraintBaseline_toBaselineOf="@id/sqr_feet_total"
                        app:layout_constraintLeft_toRightOf="@+id/sqr_feet_total"
                        android:layout_marginTop="16dp"
                        android:layout_marginLeft="12dp"
                        android:paddingBottom="16dp"/>




                </android.support.constraint.ConstraintLayout>

            </android.support.v7.widget.CardView>


        </LinearLayout>

    </ScrollView>
</android.support.design.widget.CoordinatorLayout>