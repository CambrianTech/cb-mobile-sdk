<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000"
    >


    <io.fotoapparat.view.CameraView
        android:id="@+id/camera_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible"
        tools:visibility="visible"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

    <ImageView
        android:id="@+id/image_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="#000"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>

    <com.cambriantech.harmony.view.ProgressView
        android:id="@+id/progress_view"
        android:layout_width="112dp"
        android:layout_height="112dp"
        android:visibility="gone"
        tools:visibility="visible"
        android:gravity="center"
        app:cornerRadius="16dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <ImageButton
        android:id="@+id/capture_button"
        android:layout_width="86dp"
        android:layout_height="86dp"
        android:scaleType="fitCenter"
        android:background="#0000"
        app:srcCompat="@drawable/ic_camera_iris"
        android:tint="#FFF"
        android:elevation="0dp"
        android:visibility="visible"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="48dp"/>

    <com.cambriantech.harmony.view.RoundImageButton
        android:id="@+id/capture_cancel"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="#ff0000"
        app:srcCompat="@drawable/ic_cancel"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@id/capture_confirm"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="48dp"/>

    <com.cambriantech.harmony.view.RoundImageButton
        android:id="@+id/capture_confirm"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="end"
        android:background="#18b9a0"
        app:srcCompat="@drawable/ic_check"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintLeft_toRightOf="@id/capture_cancel"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="48dp"/>


</android.support.constraint.ConstraintLayout>