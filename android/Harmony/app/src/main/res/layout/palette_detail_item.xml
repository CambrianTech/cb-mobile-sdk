<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="96dp"
    android:background="#fff"
    android:id="@+id/category_item_container">

    <ImageView
        android:id="@+id/item_thumb"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:background="#ddd"
        app:layout_constraintLeft_toLeftOf="@+id/category_item_container"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toTopOf="@+id/category_item_container"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/category_item_container"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/item_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Product Name: "
        app:layout_constraintLeft_toRightOf="@+id/item_thumb"
        android:layout_marginStart="8dp"
        app:layout_constraintTop_toTopOf="@+id/item_thumb" />

    <TextView
        android:id="@+id/item_id"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Product ID: "
        app:layout_constraintLeft_toLeftOf="@+id/item_name"
        app:layout_constraintTop_toBottomOf="@+id/item_name"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/details_button"
        android:theme="@style/ButtonTheme"
        android:layout_width="wrap_content"
        android:layout_height="55dp"
        android:drawableLeft="@drawable/ic_amazon"
        android:drawablePadding="10dp"
        android:text="Buy"
        android:textAllCaps="false"
        android:paddingRight="16dp"
        app:layout_constraintTop_toTopOf="@+id/item_thumb"
        app:layout_constraintRight_toRightOf="@+id/category_item_container"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/item_thumb" />


</android.support.constraint.ConstraintLayout>