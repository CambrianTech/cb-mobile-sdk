<?xml version="1.0" encoding="utf-8"?>
<android.support.design.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#fff"
    tools:menu="toolbar_project">

    <ScrollView
        android:id="@+id/project_scroll_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible">

        <android.support.constraint.ConstraintLayout
            android:id="@+id/project_parent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#fff"
            android:orientation="vertical">

            <View
                android:id="@+id/visualizer_click"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="64dp"
                app:layout_constraintBottom_toTopOf="@+id/guideline_project"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent" />


            <ImageView
                android:id="@+id/project_before_image"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="64dp"
                android:scaleType="centerCrop"
                app:layout_constraintBottom_toTopOf="@+id/guideline_project"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toLeftOf="@+id/guideline_center"
                app:layout_constraintTop_toTopOf="parent" />

            <android.support.constraint.Guideline
                android:id="@+id/guideline_center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.5"
                tools:layout_editor_absoluteX="0dp"
                tools:layout_editor_absoluteY="0dp" />

            <ImageView
                android:id="@+id/project_after_image"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="64dp"
                android:scaleType="centerCrop"
                app:layout_constraintBottom_toTopOf="@+id/guideline_project"
                app:layout_constraintLeft_toLeftOf="@+id/guideline_center"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent" />


            <ImageButton
                android:id="@+id/image_edit_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/button_circle"
                android:tint="#fff"
                app:layout_constraintBottom_toTopOf="@+id/image_delete_button"
                app:layout_constraintRight_toRightOf="@+id/visualizer_click"
                app:srcCompat="@drawable/ic_edit"/>

            <ImageButton
                android:id="@+id/image_delete_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/button_circle"
                android:tint="#fff"
                app:layout_constraintBottom_toTopOf="@+id/image_share_button"
                app:layout_constraintRight_toRightOf="@+id/visualizer_click"
                app:srcCompat="@drawable/ic_delete"/>

            <ImageButton
                android:id="@+id/image_share_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/button_circle"
                android:tint="#fff"
                app:layout_constraintBottom_toTopOf="@+id/before_after_backdrop"
                app:layout_constraintRight_toRightOf="@+id/visualizer_click"
                app:srcCompat="@drawable/ic_share"/>



            <View
                android:id="@+id/before_after_backdrop"
                android:layout_width="0dp"
                android:layout_height="41dp"
                android:background="@color/bar_transparency"
                app:layout_constraintBottom_toTopOf="@+id/guideline_project"
                app:layout_constraintLeft_toLeftOf="parent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Before"
                android:textColor="#fff"
                android:textSize="16sp"
                app:layout_constraintBottom_toBottomOf="@+id/before_after_backdrop"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toLeftOf="@+id/guideline_center"
                app:layout_constraintTop_toTopOf="@+id/before_after_backdrop"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="After"
                android:textColor="#fff"
                android:textSize="16sp"
                app:layout_constraintBottom_toBottomOf="@+id/before_after_backdrop"
                app:layout_constraintLeft_toLeftOf="@+id/guideline_center"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="@+id/before_after_backdrop" />


            <android.support.constraint.Guideline
                android:id="@+id/guideline_project"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_begin="300dp"
                tools:layout_editor_absoluteX="0dp"
                tools:layout_editor_absoluteY="300dp" />


            <android.support.v7.widget.RecyclerView
                android:id="@+id/project_gallery_list"
                android:layout_width="0dp"
                android:layout_height="99dp"
                android:orientation="horizontal"
                app:layoutManager="LinearLayoutManager"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="@+id/guideline_project"
                tools:listitem="@layout/project_gallery_item" />

            <TextView
                android:id="@+id/project_palette_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="24dp"
                android:text="Palette"
                android:textColor="#000"
                android:textSize="24sp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/project_gallery_list" />


            <android.support.v7.widget.RecyclerView
                android:id="@+id/project_palette_detail"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#fff"
                android:minHeight="100dp"
                android:orientation="horizontal"
                app:layoutManager="LinearLayoutManager"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/project_palette_title"
                tools:listitem="@layout/palette_detail_item" />


            <LinearLayout
                android:id="@+id/project_empty"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="#fff"
                android:clickable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="invisible"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="24dp"
                    android:gravity="center"
                    android:text="Nothing here yet!"
                    android:textSize="24sp"/>


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="24dp"
                    android:gravity="center"
                    android:text="Take a photo or load an image to start working on your project!"
                    android:textSize="20sp"/>

            </LinearLayout>


            <LinearLayout
                android:id="@+id/images_empty"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="#fff"
                android:clickable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="32dp"
                android:visibility="invisible"
                app:layout_constraintBottom_toBottomOf="@+id/before_after_backdrop"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="24dp"
                    android:gravity="center"
                    android:text="No images here yet!"
                    android:textSize="24sp"/>


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="24dp"
                    android:gravity="center"
                    android:text="Take a photo or load an image to start working on your project!"
                    android:textSize="20sp"/>

            </LinearLayout>


        </android.support.constraint.ConstraintLayout>




    </ScrollView>


    <com.cambriantech.harmony.view.BottomSheetDetail
        android:id="@+id/bottom_sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_behavior="android.support.design.widget.BottomSheetBehavior"
        tools:visibility="gone"/>

</android.support.design.widget.CoordinatorLayout>