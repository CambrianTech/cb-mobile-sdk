<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:showIn="@layout/constraint">

        <ImageView
            android:id="@+id/button_more"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/button_circle"
            android:scaleType="centerInside"
            android:tint="#fff"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_cancel"/>

        <ImageView
            android:id="@+id/button_assets"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/button_circle"
            android:scaleType="centerInside"
            android:tint="#fff"
            app:layout_constraintLeft_toLeftOf="@+id/button_more"
            app:layout_constraintRight_toRightOf="@+id/button_more"
            app:layout_constraintTop_toBottomOf="@+id/button_more"
            app:srcCompat="@drawable/ic_palette" />

        <ImageView
            android:id="@+id/button_favorites"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/button_circle"
            android:scaleType="centerInside"
            android:tint="#fff"
            android:visibility="gone"
            app:layout_constraintLeft_toLeftOf="@+id/button_more"
            app:layout_constraintRight_toRightOf="@+id/button_more"
            app:layout_constraintTop_toBottomOf="@+id/button_assets"
            app:srcCompat="@drawable/ic_heart" />

        <ImageView
            android:id="@+id/button_tools"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/button_circle"
            android:scaleType="centerInside"
            android:tint="#fff"
            app:layout_constraintLeft_toLeftOf="@+id/button_more"
            app:layout_constraintRight_toRightOf="@+id/button_more"
            app:layout_constraintTop_toBottomOf="@+id/button_favorites"
            app:srcCompat="@drawable/ic_brush" />

        <ImageView
            android:id="@+id/button_undo"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/button_circle"
            android:scaleType="centerInside"
            android:visibility="gone"
            android:tint="#666"
            app:layout_constraintLeft_toLeftOf="@+id/button_more"
            app:layout_constraintRight_toRightOf="@+id/button_more"
            app:layout_constraintTop_toBottomOf="@+id/button_tools"
            app:srcCompat="@drawable/ic_undo"/>


        <LinearLayout
            android:id="@+id/menu_tools"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:alpha="0"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="@id/button_tools"
            app:layout_constraintRight_toLeftOf="@id/button_tools"
            app:layout_constraintTop_toTopOf="@id/button_tools">


            <ImageButton
                android:id="@+id/lighting_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/button_circle"
                android:scaleType="centerInside"
                android:tint="#fff"
                app:srcCompat="@drawable/ic_lightbulb_on"/>

            <com.cambriantech.harmony.view.RoundedContainer
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/button_fill"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="4dp"
                    android:background="#0000"
                    android:scaleType="centerInside"
                    android:tint="#fff"
                    app:srcCompat="@drawable/ic_bucket"/>

                <ImageButton
                    android:id="@+id/button_brush"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="4dp"
                    android:background="#0000"
                    android:scaleType="centerInside"
                    android:tint="#fff"
                    app:srcCompat="@drawable/ic_brush" />

                <ImageButton
                    android:id="@+id/button_eraser"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="#0000"
                    android:scaleType="centerInside"
                    android:tint="#444"
                    app:srcCompat="@drawable/ic_eraser" />
            </com.cambriantech.harmony.view.RoundedContainer>
        </LinearLayout>


        <android.support.v7.widget.RecyclerView
            android:id="@+id/rv_assets"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginEnd="8dp"
            android:orientation="horizontal"
            android:visibility="invisible"
            app:layoutManager="LinearLayoutManager"
            app:layout_constraintBottom_toBottomOf="@+id/button_assets"
            app:layout_constraintRight_toLeftOf="@+id/button_assets"
            app:layout_constraintTop_toTopOf="@+id/button_assets"
            tools:listitem="@layout/asset_item"/>


        <android.support.v7.widget.RecyclerView
            android:id="@+id/rv_favorites"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginEnd="8dp"
            android:orientation="horizontal"
            android:visibility="gone"
            app:layoutManager="LinearLayoutManager"
            app:layout_constraintBottom_toBottomOf="@+id/button_favorites"
            app:layout_constraintRight_toLeftOf="@+id/button_favorites"
            app:layout_constraintTop_toTopOf="@+id/button_favorites"
            tools:listitem="@layout/asset_item"/>

</merge>